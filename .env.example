# Copiar a .env y completar. El archivo .env NUNCA se sube al repositorio.
# Usar claves largas y aleatorias, solo con letras y números (van dentro de URLs).

# --- docker compose ---------------------------------------------------------
MONGO_USUARIO_ROOT=root
MONGO_CLAVE_ROOT=cambiar-clave-root
MONGO_USUARIO_APP=intelitalia
MONGO_CLAVE_APP=cambiar-clave-app
REDIS_CLAVE=cambiar-clave-redis
# Puerto donde se publica el frontend (Nginx).
PUERTO_WEB=8080

# --- API (backend) ----------------------------------------------------------
# En docker compose, MONGO_URI y REDIS_URL se arman con las variables de arriba.
# Estos valores son para correr la API en local (npm run start:dev) con
# docker-compose.dev.yml, que publica MongoDB y Redis en 127.0.0.1.
NODE_ENV=development
PUERTO=3000
MONGO_URI=mongodb://intelitalia:cambiar-clave-app@127.0.0.1:27017/intelitalia
REDIS_URL=redis://:cambiar-clave-redis@127.0.0.1:6379
# Origen permitido por CORS: Vite en desarrollo; la URL pública en el servidor.
ORIGEN_FRONTEND=http://localhost:5173

# --- Login con Google y sesión ----------------------------------------------
# Obligatorias: la API no arranca si están vacías.
# Client ID de OAuth del proyecto en Google Cloud Console (tipo "Aplicación web").
GOOGLE_CLIENT_ID=
# Al menos 32 caracteres aleatorios y distinto en cada entorno. Para generarlo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRETO=
# Duración de la sesión en segundos (36000 = 10 horas, una jornada).
JWT_DURACION_SEGUNDOS=36000
# Vacío: cualquier cuenta de Google (igual tiene que estar en la lista blanca).
# Con un dominio (p. ej. escuela.cl): solo cuentas de ese Google Workspace.
DOMINIO_GOOGLE_PERMITIDO=
# Correo de la Directora: su usuario se crea al iniciar la API si no existe.
# Vacío: no se crea. Sin una Directora registrada, nadie puede agregar usuarios.
CORREO_DIRECTORA_INICIAL=

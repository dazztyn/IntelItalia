{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "testTimeout": 120000,
  "maxWorkers": 1,
  "globalSetup": "<rootDir>/entorno-global.ts",
  "globalTeardown": "<rootDir>/limpiar-entorno-global.ts"
}
